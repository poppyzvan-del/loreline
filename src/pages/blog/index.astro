---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const fmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog — 本地化与叙事笔记"
  description="Loreline 的游戏本地化与叙事设计笔记：双语台词写作、术语管理、风格指南经验。"
>
  <section class="container-wide py-12">
    <h1 class="text-3xl font-bold md:text-4xl">本地化与叙事笔记</h1>
    <p class="mt-2 text-brand-600">来自实践的中英台词写作、术语管理与风格指南经验。</p>

    {posts.length === 0 ? (
      <div class="mt-12 rounded-xl border border-dashed border-brand-300 p-12 text-center">
        <p class="text-lg text-brand-500">第一篇文章即将发布。</p>
      </div>
    ) : (
      <ul class="mt-8 divide-y divide-brand-200">
        {posts.map((post) => (
          <li class="py-6">
            <a href={`/blog/${post.slug}`} class="no-underline">
              <h2 class="text-xl font-bold text-brand-950 hover:text-gold-600">{post.data.title}</h2>
            </a>
            <p class="mt-1 text-sm text-brand-500">{fmt.format(post.data.publishedAt)}</p>
            <p class="mt-2 text-brand-700">{post.data.description}</p>
            <div class="mt-3 flex gap-2">
              {post.data.tags.map((t) => <span class="badge">{t}</span>)}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
