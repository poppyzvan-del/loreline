# ============================================
# Loreline 环境变量占位
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# ============================================

# Lemon Squeezy —— 支付与自动交付
# 获取：Lemon Squeezy 后台 → Settings → API → Create API Key
LEMON_SQUEEZY_API_KEY=lsk_your_api_key_here
# 每个 Pack 在 LS 后台建一个 Product，从其"Buy"按钮复制完整 checkout 链接，
# 填入对应 Pack frontmatter 的 lsCheckoutUrl（见 src/content/packs/*.md）
# Store ID（参考用）：LS 后台 → Settings → Store
LEMON_SQUEEZY_STORE_ID=12345

# ConvertKit —— 邮箱收集（免费样例下载换订阅）
# 获取：ConvertKit 后台 → Settings → API Keys
CONVERTKIT_API_KEY=your_convertkit_api_key_here
# 表单 ID（免费样例订阅表单）：ConvertKit 后台 → Forms → 选中表单 → URL 里的数字
# PUBLIC_ 前缀使其暴露到客户端（form action 需要），这是 ConvertKit 推荐做法
PUBLIC_CONVERTKIT_FORM_ID=your_convertkit_form_id_here
# ConvertKit 序列 ID（可选，后期自动化邮件序列用）
CONVERTKIT_SEQUENCE_ID=

# 站点
SITE_URL=https://loreline.example.com  # 部署后改真实域名
SITE_NAME=Loreline

# 后期 AI 生产管线（第二阶段，GitHub Actions 用）
# TapTap MCP endpoint 或 LLM API（按实际选用）
TAPTAP_ENDPOINT=
LLM_API_KEY=
GITHUB_TOKEN=  # GitHub Actions 自动提供，本地测试用 PAT
